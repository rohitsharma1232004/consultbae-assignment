        "query": "SELECT p.person_id, p.full_name,\n  TRIM(BOTH ', ' FROM CONCAT_WS(', ',\n    (SELECT GROUP_CONCAT(DISTINCT skills SEPARATOR ', ') FROM staging_naukri WHERE person_id = p.person_id),\n    (SELECT GROUP_CONCAT(DISTINCT skill_tags SEPARATOR ', ') FROM staging_gig_workers WHERE person_id = p.person_id)\n  )) AS combined_skills\nFROM people p\nWHERE p.skill_category IS NULL\n  AND (\n    EXISTS (SELECT 1 FROM staging_naukri WHERE person_id = p.person_id)\n    OR EXISTS (SELECT 1 FROM staging_gig_workers WHERE person_id = p.person_id)\n  );\n",
